{
  "expo": {
    "name": "Fieldnote",
    "slug": "fieldnote",
    "version": "1.1.1",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "scheme": "fieldnote",
    "userInterfaceStyle": "light",
    "newArchEnabled": false,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#f4ecdd"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.fieldnote.canvas"
    },
    "android": {
      "package": "com.fieldnote.canvas",
      "versionCode": 12,
      "adaptiveIcon": {
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png",
        "backgroundColor": "#0f172a"
      },
      "permissions": [
        "READ_MEDIA_IMAGES",
        "READ_EXTERNAL_STORAGE"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-asset",
      "expo-font",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Fieldnote to place photos on your board."
        }
      ],
      "expo-system-ui"
    ],
    "extra": {
      "eas": {
        "projectId": "80fcf1fb-aecc-4ed7-b394-e98356974ee7"
      }
    },
    "owner": "thomasdensley"
  }
}
